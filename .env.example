# Di Vercel isi lewat Settings > Environment Variables. Lokal: salin ke .env.local. JANGAN commit.

# Shopee Open Platform Console (open.shopee.com) > App
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=

# production | sandbox
SHOPEE_ENV=production

# Rahasia akses ke server MCP & halaman connect (min 16 karakter, acak panjang).
# Buat: openssl rand -hex 24
MCP_SECRET=

# URL publik aplikasi, dipakai untuk Redirect URL Shopee. Kosongkan di Vercel (otomatis dari domain produksi).
# Lokal: http://localhost:3000
APP_BASE_URL=

# true = blokir semua operasi tulis (audit saja)
SHOPEE_READ_ONLY=false

# Otomatis terisi saat memasang integrasi Upstash Redis dari Vercel Marketplace
# (KV_REST_API_URL / KV_REST_API_TOKEN atau UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN)
