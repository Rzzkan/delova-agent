# Di Vercel isi lewat Settings > Environment Variables. Lokal: salin ke .env.local. JANGAN commit.

# Shopee Open Platform Console (open.shopee.com) > App
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=

# production | sandbox
SHOPEE_ENV=production

# TikTok Shop Partner Center (partner.tiktokshop.com) > App & Service. Opsional: kosongkan bila tidak memakai TikTok.
# Redirect URL di app TikTok: https://<domain>/api/tiktok/callback
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_SERVICE_ID=

# Rahasia akses ke server MCP & halaman connect (min 16 karakter, acak panjang).
# Buat: openssl rand -hex 24
MCP_SECRET=

# URL publik aplikasi, dipakai untuk Redirect URL Shopee. Kosongkan di Vercel (otomatis dari domain produksi).
# Lokal: http://localhost:3000
APP_BASE_URL=

# true = blokir semua operasi tulis (audit saja)
SHOPEE_READ_ONLY=false

# Otomatis terisi saat memasang integrasi Upstash Redis dari Vercel Marketplace
# (KV_REST_API_URL / KV_REST_API_TOKEN atau UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN)

# ===== Khusus deploy Docker di VPS (lihat DEPLOY-VPS.md) =====
# Port lokal (hanya 127.0.0.1) untuk reverse proxy. Ubah bila 3210 sudah dipakai.
# AGENT_PORT=3210
# URL publik (https), dipakai untuk Redirect URL Shopee/TikTok. Contoh: https://agent.delova.id
# APP_BASE_URL=https://agent.delova.id
# Hanya bila Caddy/Traefik berjalan di Docker (docker-compose.proxy.yml):
# PROXY_NETWORK=
# COMPOSE_FILE=docker-compose.yml:docker-compose.proxy.yml
