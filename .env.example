# Salin ke .env lalu isi. JANGAN commit file .env.
# Ambil dari Shopee Open Platform Console (open.shopee.com) > App > Partner ID & Key
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=

# production | sandbox
SHOPEE_ENV=production

# Opsional, diisi otomatis saat auth-exchange. Bisa diisi manual untuk 1 toko.
SHOPEE_SHOP_ID=

# Harus sama dengan Redirect URL yang didaftarkan di app Shopee
SHOPEE_REDIRECT_URL=https://example.com/callback

# true = blokir semua operasi tulis (aman untuk uji coba / audit saja)
SHOPEE_READ_ONLY=false

SHOPEE_TOKEN_FILE=data/tokens.json
